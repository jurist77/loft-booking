{
  "name": "loft-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-mode.mjs demo dev",
    "build": "node scripts/next-mode.mjs demo build",
    "start": "node scripts/next-mode.mjs demo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture:acceptance": "node scripts/capture-acceptance.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "preview:demo": "node scripts/serve-demo.mjs",
    "audit:demo": "node scripts/audit-demo.mjs",
    "verify:demo": "node scripts/verify-demo.mjs",
    "dev:server": "node scripts/next-mode.mjs server dev",
    "build:server": "node scripts/next-mode.mjs server build",
    "start:server": "node scripts/next-mode.mjs server start",
    "db:env": "node scripts/local-env.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:server:http": "node scripts/verify-server.mjs",
    "test:demo:isolation": "node scripts/verify-demo-isolation.mjs",
    "test:server:http:failure": "node scripts/verify-health-failure.mjs",
    "db:init": "node --env-file-if-exists=.env.sqlite.local --conditions=react-server scripts/database.mjs init",
    "db:migrate": "node --env-file-if-exists=.env.sqlite.local --conditions=react-server scripts/database.mjs migrate",
    "db:check": "node --env-file-if-exists=.env.sqlite.local --conditions=react-server scripts/database.mjs check",
    "db:backup": "node --env-file-if-exists=.env.sqlite.local --conditions=react-server scripts/database.mjs backup",
    "db:restore": "node --env-file-if-exists=.env.sqlite.local --conditions=react-server scripts/database.mjs restore"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
