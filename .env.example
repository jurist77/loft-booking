# Local development only. Prefer npm run db:env to generate ignored local files.
# Never put server credentials in NEXT_PUBLIC_*.
APP_MODE=server
POSTGRES_DB=studio1925_dev
POSTGRES_PORT=54329
POSTGRES_USER=studio_dev_bootstrap
POSTGRES_PASSWORD=
POSTGRES_APP_USER=studio_dev_app
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATION_USER=studio_dev_migrator
POSTGRES_MIGRATION_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=2000
MIGRATION_QUERY_TIMEOUT_MS=30000

# Only .env.test.local uses these; always a separate *_test database/roles/port.
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
