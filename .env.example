# SERVER only. Use an absolute path OUTSIDE the checkout/build/public directories.
# mkdir parent with mode 0700; db:init creates a 0600 SQLite file.
APP_MODE=server
SQLITE_PATH=/var/lib/studio1925/studio.sqlite
SQLITE_BUSY_TIMEOUT_MS=1000
# Exact browser Origin. Non-loopback origins require HTTPS; do not derive this from Host/XFF.
API_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Enable only behind a trusted proxy overwriting X-Studio-Client-IP; Next must remain loopback-only.
API_TRUST_PROXY=false

# Optional Telegram worker, SERVER runtime only (npm *:server sets 1 at dev/start,
# builds force 0; the managed service sets 1 in its own systemd unit).
STUDIO_TELEGRAM_WORKER=1
# Optional absolute private file outside the application. Default:
# <SQLite directory>/settings/telegram-bot.json, mode 0600, owned by app UID.
# Token is entered in that protected file, never a NEXT_PUBLIC variable or SQLite.
# TELEGRAM_CONFIG_FILE=/var/lib/studio1925/settings/telegram-bot.json
