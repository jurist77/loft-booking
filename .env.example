# SERVER only. Use an absolute path OUTSIDE the checkout/build/public directories.
# mkdir parent with mode 0700; db:init creates a 0600 SQLite file.
APP_MODE=server
SQLITE_PATH=/var/lib/studio1925/studio.sqlite
SQLITE_BUSY_TIMEOUT_MS=1000
# Exact browser Origin. Non-loopback origins require HTTPS; do not derive this from Host/XFF.
API_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Enable only behind a trusted proxy overwriting X-Studio-Client-IP; Next must remain loopback-only.
API_TRUST_PROXY=false
