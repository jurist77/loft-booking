{
  "config_template": {
    "admin": {
      "listen": "unix//run/studio1925-tls/admin.sock"
    },
    "apps": {
      "http": {
        "servers": {
          "studio_http": {
            "listen": [
              ":80"
            ],
            "protocols": [
              "h1"
            ],
            "routes": [
              {
                "handle": [
                  {
                    "handler": "static_response",
                    "headers": {
                      "Location": [
                        "https://reference.example.org{http.request.uri}"
                      ]
                    },
                    "status_code": 308
                  }
                ],
                "match": [
                  {
                    "host": [
                      "reference.example.org"
                    ],
                    "method": [
                      "GET",
                      "HEAD"
                    ]
                  }
                ]
              },
              {
                "handle": [
                  {
                    "handler": "static_response",
                    "status_code": 405
                  }
                ]
              }
            ]
          },
          "studio_https": {
            "automatic_https": {
              "disable_redirects": true
            },
            "listen": [
              ":443"
            ],
            "protocols": [
              "h1",
              "h2"
            ],
            "routes": [
              {
                "handle": [
                  {
                    "handler": "headers",
                    "request": {
                      "delete": [
                        "Forwarded",
                        "X-Forwarded-For",
                        "X-Forwarded-Host",
                        "X-Forwarded-Proto",
                        "X-Real-IP",
                        "X-Studio-Client-IP"
                      ]
                    },
                    "response": {
                      "set": {
                        "Content-Security-Policy": [
                          "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
                        ],
                        "Permissions-Policy": [
                          "camera=(), microphone=(), geolocation=()"
                        ],
                        "Referrer-Policy": [
                          "no-referrer"
                        ],
                        "Strict-Transport-Security": [
                          "max-age=300"
                        ],
                        "X-Content-Type-Options": [
                          "nosniff"
                        ],
                        "X-Frame-Options": [
                          "DENY"
                        ]
                      }
                    }
                  },
                  {
                    "handler": "reverse_proxy",
                    "headers": {
                      "request": {
                        "set": {
                          "Host": [
                            "reference.example.org"
                          ],
                          "X-Forwarded-Host": [
                            "reference.example.org"
                          ],
                          "X-Forwarded-Proto": [
                            "https"
                          ],
                          "X-Studio-Client-IP": [
                            "{http.request.remote.host}"
                          ]
                        }
                      }
                    },
                    "upstreams": [
                      {
                        "dial": "127.0.0.1:3000"
                      }
                    ]
                  }
                ],
                "match": [
                  {
                    "host": [
                      "reference.example.org"
                    ]
                  }
                ]
              },
              {
                "handle": [
                  {
                    "handler": "static_response",
                    "status_code": 421
                  }
                ]
              }
            ]
          }
        }
      },
      "tls": {
        "automation": {
          "policies": [
            {
              "issuers": [
                {
                  "ca": "https://acme-v02.api.letsencrypt.org/directory",
                  "challenges": {
                    "tls-alpn": {
                      "disabled": true
                    }
                  },
                  "module": "acme"
                }
              ],
              "subjects": [
                "reference.example.org"
              ]
            }
          ]
        }
      }
    },
    "storage": {
      "module": "file_system",
      "root": "/var/lib/studio1925-tls/storage"
    }
  },
